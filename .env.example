# RESEND_API_KEY: Required for the contact form (api/contact.ts).
# Get it from https://resend.com/api-keys
RESEND_API_KEY="re_your_key_here"

# ─────────────────────────────────────────────────────────────────────────────
# WHERE CONTACT FORM MAILS LAND
#
# CONTACT_TO is the public inbox shown on the site (src/data/profile.ts).
# ─────────────────────────────────────────────────────────────────────────────
CONTACT_TO="dvega6442@gmail.com"

# ─────────────────────────────────────────────────────────────────────────────
# WHY THE FORM CAN STILL FAIL WITH A VALID API KEY
#
# Without CONTACT_FROM the sender is `onboarding@resend.dev`, Resend's test
# address, and it has a hard rule: it only delivers to the email registered on
# your Resend account. Anything else is rejected before the mail leaves, with:
#
#   You can only send testing emails to your own email address (...)
#
# So if the Resend account is not registered with dvega6442@gmail.com, the test
# sender will not deliver to it. The auto-reply to the visitor also cannot be
# delivered at all with the test sender, for the same reason.
#
# The real fix: verify your domain at https://resend.com/domains, add the DNS
# records Resend gives you (one MX, two TXT: SPF and DKIM), then set CONTACT_FROM
# to any address on that verified domain. Verified domains are included in the
# free plan (3 of them), so this costs nothing.
#
# The address does not need a real mailbox behind it. SPF and DKIM are what make
# Gmail accept it. Nobody replies to it: the code sets replyTo to the inbox above
# on the receipt, and to the visitor's own address on the message to you.
# ─────────────────────────────────────────────────────────────────────────────
CONTACT_FROM="Gonzalo Daniel Vega <contacto@gonzalodanielvega.com>"

# On Vercel these must also be set in the dashboard:
# Project -> Settings -> Environment Variables -> add each one for
# Production, Preview and Development. A local .env.local is NOT deployed.
